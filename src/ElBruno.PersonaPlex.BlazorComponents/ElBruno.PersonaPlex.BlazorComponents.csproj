<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks></TargetFrameworks>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>ElBruno.PersonaPlex.BlazorComponents</RootNamespace>
    <PackageId>ElBruno.PersonaPlex.BlazorComponents</PackageId>
    <Version>0.6.1</Version>
    <Authors>Bruno Capuano</Authors>
    <Description>Server-backed Blazor UI shell for ElBruno.PersonaPlex. Includes reusable Razor components for half-duplex, turn-based speech-to-speech experiences on top of the existing file-based PersonaPlex pipeline.</Description>
    <PackageTags>blazor;razor;personaplex;speech-to-speech;onnxruntime;half-duplex;turn-based;file-based;server-side;audio;ui</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elbruno/ElBruno.PersonaPlex</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elbruno/ElBruno.PersonaPlex</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon Condition="Exists('..\..\images\nuget_01.png')">nuget_01.png</PackageIcon>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ElBruno.PersonaPlex\ElBruno.PersonaPlex.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Condition="Exists('README.md')" />
    <None Include="..\..\images\nuget_01.png" Pack="true" PackagePath="\" Link="nuget_01.png" Condition="Exists('..\..\images\nuget_01.png')" />
  </ItemGroup>

</Project>
