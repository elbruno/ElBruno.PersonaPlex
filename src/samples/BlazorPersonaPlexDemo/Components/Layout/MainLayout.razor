@inherits LayoutComponentBase

<div class="app-shell">
    <header class="border-bottom bg-dark-subtle shadow-sm">
        <div class="container-xxl py-3 d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-2">
            <div>
                <div class="text-uppercase small fw-semibold text-primary-emphasis">BlazorPersonaPlexDemo</div>
                <div class="fs-4 fw-bold">Server-backed, model-free component showcase</div>
            </div>
            <div class="d-flex align-items-center gap-3 text-secondary">
                <span><i class="bi bi-cpu me-1"></i>No ONNX startup cost</span>
                <span><i class="bi bi-hdd-network me-1"></i>Blazor Server</span>
            </div>
        </div>
    </header>

    <div class="container-xxl py-4">
        <div class="row g-4">
            <aside class="col-lg-3 col-xxl-2">
                <NavMenu />
            </aside>

            <main class="col-lg-9 col-xxl-10">
                <article class="content">
                    @Body
                </article>
            </main>
        </div>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
